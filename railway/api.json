{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "php /var/www/artisan start",
    "preDeployCommand": "php /var/www/artisan migrate --force",
    "healthcheckPath": "/api",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
