{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "php /var/www/artisan queue:work database --queue='media.summary,rss.sync,videotranscriber.smart-summary' --sleep=3 --timeout=300 --max-time=3600 --memory=256",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
