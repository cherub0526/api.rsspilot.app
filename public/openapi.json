{
    "openapi": "3.0.0",
    "info": {
        "title": "CatchUp API",
        "version": "0.1.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:9501",
            "description": "Local server"
        },
        {
            "url": "https://catchupai.on-forge.com",
            "description": "Production server"
        }
    ],
    "paths": {
        "/api/v1/auth/forgot-password": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Send password reset email",
                "operationId": "07fd4a7026f9d0f545781bb5d51a150a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "account"
                                ],
                                "properties": {
                                    "account": {
                                        "type": "string",
                                        "maxLength": 255,
                                        "minLength": 6,
                                        "example": "user@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reset email sent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "We have emailed your password reset link."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    }
                }
            }
        },
        "/api/v1/media/{mediaId}/captions": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "List captions for a media",
                "operationId": "9409490572c31e03e833016c4ac0ff52",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/mediaId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                                                    },
                                                    "locale": {
                                                        "type": "string",
                                                        "example": "en"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/media/{mediaId}/captions/{captionId}": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "Get caption details",
                "operationId": "8081bfa2aad11bed5ab3bc5166700497",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/mediaId"
                    },
                    {
                        "$ref": "#/components/parameters/captionId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CaptionResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/media/{mediaId}/chat": {
            "post": {
                "tags": [
                    "Media"
                ],
                "summary": "Chat with video content",
                "operationId": "ee42306c9208f2c0eb2a6b9a9fe07a03",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/mediaId"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "messages"
                                ],
                                "properties": {
                                    "messages": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "role",
                                                "content"
                                            ],
                                            "properties": {
                                                "role": {
                                                    "type": "string",
                                                    "enum": [
                                                        "user",
                                                        "assistant",
                                                        "system"
                                                    ],
                                                    "example": "user"
                                                },
                                                "content": {
                                                    "type": "string",
                                                    "example": "What is this video about?"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "minItems": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Assistant reply",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "role": {
                                            "type": "string",
                                            "example": "assistant"
                                        },
                                        "content": {
                                            "type": "string",
                                            "example": "This video covers..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    }
                }
            }
        },
        "/api/v1/media/{mediaId}/custom-prompt": {
            "post": {
                "tags": [
                    "Media"
                ],
                "summary": "Run a custom prompt against a media caption",
                "operationId": "24a59e0125f7513ecdb40d977c0e3dd8",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/mediaId"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "prompt"
                                ],
                                "properties": {
                                    "prompt": {
                                        "type": "string",
                                        "example": "影片中出現了哪些食物？"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Custom prompt result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "text": {
                                            "type": "string",
                                            "example": "影片中出現了拉麵、壽司和天婦羅。"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/media": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "List user media",
                "operationId": "8323ee267ab5b68cb79698120d010372",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/type"
                    },
                    {
                        "$ref": "#/components/parameters/range"
                    },
                    {
                        "$ref": "#/components/parameters/limit"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/MediaResource"
                                            }
                                        },
                                        "links": {
                                            "$ref": "#/components/schemas/PaginatorLinks"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/PaginatorMeta"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/media/{mediaId}": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "Get media details",
                "operationId": "20711b321232fa92171b6d19a7f6307b",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/mediaId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MediaResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/rss": {
            "get": {
                "tags": [
                    "RSS"
                ],
                "summary": "List RSS feed subscriptions",
                "operationId": "0d7b129ba90eb69783226b35043f51e6",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "description": "Type of RSS feed",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "youtube"
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Number of items per page (1-10)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 10,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "id": {
                                                "type": "string",
                                                "example": "01JCXYZ123456789ABCDEFGHIJ"
                                            },
                                            "type": {
                                                "type": "string",
                                                "example": "youtube"
                                            },
                                            "url": {
                                                "type": "string",
                                                "example": "https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxxx"
                                            },
                                            "title": {
                                                "type": "string",
                                                "example": "Channel Name"
                                            },
                                            "created_at": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2024-01-01 12:00:00"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request parameters",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "type": [
                                                    "The type field is required."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/rss": {
            "post": {
                "tags": [
                    "RSS"
                ],
                "summary": "Subscribe to RSS feed",
                "operationId": "82292641aed78e6eccbc42e2ac3ad3df",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "type",
                                    "url"
                                ],
                                "properties": {
                                    "type": {
                                        "description": "Type of RSS feed",
                                        "type": "string",
                                        "enum": [
                                            "youtube"
                                        ],
                                        "example": "youtube"
                                    },
                                    "url": {
                                        "description": "YouTube channel URL or RSS feed URL",
                                        "type": "string",
                                        "format": "url",
                                        "example": "https://www.youtube.com/@channelname"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "RSS feed subscribed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "example": "01JCXYZ123456789ABCDEFGHIJ"
                                        },
                                        "type": {
                                            "type": "string",
                                            "example": "youtube"
                                        },
                                        "url": {
                                            "type": "string",
                                            "example": "https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxxx"
                                        },
                                        "title": {
                                            "type": "string",
                                            "example": "Channel Name"
                                        },
                                        "created_at": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2024-01-01 12:00:00"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request parameters or invalid RSS feed URL",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "url": [
                                                    "The provided URL is not a valid RSS feed."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/rss/{rssId}": {
            "delete": {
                "tags": [
                    "RSS"
                ],
                "summary": "Unsubscribe from RSS feed",
                "operationId": "078a1c1673901309a9fad8d8c8c6124a",
                "parameters": [
                    {
                        "name": "rssId",
                        "in": "path",
                        "description": "RSS feed ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "01JCXYZ123456789ABCDEFGHIJ"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successfully unsubscribed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "ok"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "RSS feed not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Resource not found"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "CaptionResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                    },
                    "locale": {
                        "type": "string",
                        "example": "en"
                    },
                    "segments": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "start": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 0
                                },
                                "end": {
                                    "type": "number",
                                    "format": "float",
                                    "example": 3.5
                                },
                                "text": {
                                    "type": "string",
                                    "example": "Hello, world."
                                }
                            },
                            "type": "object"
                        }
                    }
                },
                "type": "object"
            },
            "MediaResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                    },
                    "url": {
                        "type": "string",
                        "example": "https://www.youtube.com/embed/dQw4w9WgXcQ"
                    },
                    "type": {
                        "type": "string",
                        "example": "youtube"
                    },
                    "title": {
                        "type": "string",
                        "example": "Video Title"
                    },
                    "description": {
                        "type": "string",
                        "example": "Video description"
                    },
                    "thumbnail": {
                        "type": "string",
                        "example": "https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg"
                    },
                    "published_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01 12:00:00"
                    },
                    "short_summary": {
                        "type": "string",
                        "example": "A short summary of the video content."
                    }
                },
                "type": "object"
            },
            "PaddleResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "pro_01abc123"
                    }
                },
                "type": "object"
            },
            "PaginatorLinks": {
                "properties": {
                    "first": {
                        "type": "string",
                        "example": "http://localhost/api/v1/media?page=1"
                    },
                    "last": {
                        "type": "string",
                        "example": "http://localhost/api/v1/media?page=5"
                    },
                    "prev": {
                        "type": "string",
                        "example": null,
                        "nullable": true
                    },
                    "next": {
                        "type": "string",
                        "example": "http://localhost/api/v1/media?page=2",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PaginatorMeta": {
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 12
                    },
                    "total": {
                        "type": "integer",
                        "example": 50
                    }
                },
                "type": "object"
            },
            "PlanResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                    },
                    "title": {
                        "type": "string",
                        "example": "Pro Plan"
                    },
                    "description": {
                        "type": "string",
                        "example": "Full access to all features"
                    },
                    "channel_limit": {
                        "type": "integer",
                        "example": 10
                    },
                    "video_limit": {
                        "type": "integer",
                        "example": 100
                    },
                    "chat_limit": {
                        "type": "integer",
                        "example": 500
                    },
                    "prices": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PriceResource"
                        }
                    },
                    "paddle": {
                        "$ref": "#/components/schemas/PaddleResource"
                    }
                },
                "type": "object"
            },
            "PriceResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                    },
                    "unit": {
                        "type": "string",
                        "example": "month"
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 9.99
                    },
                    "paddle": {
                        "$ref": "#/components/schemas/PaddleResource"
                    }
                },
                "type": "object"
            },
            "RSSResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                    },
                    "type": {
                        "type": "string",
                        "example": "youtube"
                    },
                    "url": {
                        "type": "string",
                        "example": "https://www.youtube.com/feeds/videos.xml?channel_id=UCxxxxxx"
                    },
                    "title": {
                        "type": "string",
                        "example": "Channel Title"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-01-01 12:00:00"
                    }
                },
                "type": "object"
            },
            "SummaryResource": {
                "properties": {
                    "locale": {
                        "type": "string",
                        "example": "en"
                    },
                    "status": {
                        "type": "string",
                        "example": "ready"
                    },
                    "text": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "UserResource": {
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "01JCXYZ123456789ABCDEFGHIJ"
                    },
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@example.com"
                    },
                    "account": {
                        "type": "string",
                        "example": "johndoe"
                    },
                    "setting": {
                        "type": "object"
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "400": {
                "description": "Invalid request parameters",
                "content": {
                    "application/json": {
                        "schema": {
                            "properties": {
                                "errors": {
                                    "type": "object",
                                    "example": {
                                        "field": [
                                            "The field is required."
                                        ]
                                    }
                                }
                            },
                            "type": "object"
                        }
                    }
                }
            }
        },
        "parameters": {
            "captionId": {
                "name": "captionId",
                "in": "path",
                "description": "Caption ID (ULID)",
                "required": true,
                "schema": {
                    "type": "string",
                    "example": "01JCXYZ123456789ABCDEFGHIJ"
                }
            },
            "mediaId": {
                "name": "mediaId",
                "in": "path",
                "description": "Media ID (ULID)",
                "required": true,
                "schema": {
                    "type": "string",
                    "example": "01JCXYZ123456789ABCDEFGHIJ"
                }
            },
            "limit": {
                "name": "limit",
                "in": "query",
                "description": "Number of items per page (1-10, default 12)",
                "required": false,
                "schema": {
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 1
                }
            },
            "range": {
                "name": "range",
                "in": "query",
                "description": "Date range filter",
                "required": false,
                "schema": {
                    "type": "string",
                    "enum": [
                        "today",
                        "week",
                        "month",
                        "year"
                    ]
                }
            },
            "type": {
                "name": "type",
                "in": "query",
                "description": "Type of media",
                "required": true,
                "schema": {
                    "type": "string",
                    "enum": [
                        "youtube",
                        "spotify"
                    ]
                }
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Media",
            "description": "Media"
        },
        {
            "name": "RSS",
            "description": "RSS"
        }
    ]
}