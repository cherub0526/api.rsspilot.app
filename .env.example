APP_NAME=Hypervel
APP_ENV=local
APP_DEBUG=true
APP_KEY=
# 缺席時 config('app.url') 退回 http://localhost，信件裡的圖片就會指向
# 收件人自己的電腦，靜靜破圖。正式環境一定要設。
APP_URL=http://localhost:9501
# 前端站台的基底 URL。驗證信、重設密碼、每日摘要的連結都以它為基底
# （見 App\Mail\*），不是 API 的位址。
CLIENT_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_CHANNELS=single
LOG_LEVEL=debug
# stderr channel 的 formatter class；留空就用 Monolog 的預設。
LOG_STDERR_FORMATTER=

DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=hypervel
# DB_USERNAME=root
# DB_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
CDN_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

CACHE_DRIVER=redis

QUEUE_CONNECTION=database
# 佇列多久之後判定「這個 job 沒人在跑」並重新發給別人（秒）。
#
# **必須大於所有 worker 的 --timeout**，否則 job 還在跑就被另一個 process
# 重新領走：同一件事做兩次，或 attempts 累加到上限後以
# MaxAttemptsExceededException 收場——症狀看起來像外部服務一直失敗。
# 目前最大的 --timeout 是 300（見 supervisor/README.md），所以設 360。
# 它不在任何 worker 的旗標旁邊，改 --timeout 時最容易漏掉這一個。
DB_QUEUE_RETRY_AFTER=360

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET=
# access token 的有效期（分鐘），預設 120。
JWT_TTL=120

# 本機指向跑在宿主機上的 mailpit（容器內要用 host.docker.internal 才連得到，
# localhost 是容器自己）。Railway 上則是 mailpit.railway.internal。
# 兩邊都不會真的把信寄出去。
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@rsspilot.app
MAIL_FROM_NAME="${APP_NAME}"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

OPENROUTER_API_KEY=
AI_DEFAULT_MODEL=openrouter/auto
# 每日提問額度的日界時區，留空則採用 config/ai.php 的預設值 Asia/Taipei
AI_CHAT_QUOTA_TIMEZONE=
# 對話要不要把模型的思考過程一起串給前端，以及思考力度（low / medium / high）。
# 留空或填 off 就完全不要思考內容。推理 token 按 output 計價，調高等於直接墊高
# 每日提問額度的成本天花板——要動之前先看 docs/lore/prompts/business-rules.md。
AI_CHAT_REASONING_EFFORT=low
# 上網查資料用的 Tavily API key。留空就沒有這個工具（不報錯，當作能力不存在）。
# 誰能用是方案決定的（plans.agent_enabled，目前只有 Advance），不是這裡。
TAVILY_API_KEY=
# 每次搜尋抓幾筆結果、每一輪對話最多搜幾次。後者擋的不只是 Tavily 的錢——
# 每次工具呼叫都要把摘要與歷史重送一遍，input token 與延遲一起漲。
AI_CHAT_WEB_SEARCH_MAX_RESULTS=3
AI_CHAT_WEB_SEARCH_MAX_RUNS=3

# Paddle。sandbox 與 live 是兩個完全獨立的帳號：token、API key、webhook 密鑰、
# 以及 products/prices 的 ID 全都不通用，切換環境時四個值要一起換。
# client token 是前端用的（sandbox 前綴 test_、live 前綴 live_），由
# POST /v1/subscriptions 回給前端，不要寫進前端的 bundle。
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
# 建立 notification destination 時只會顯示一次的 endpoint_secret_key。
# 沒設的話 webhook 一律拒絕（不是放行），見 PaddleController::assertValidSignature()。
PADDLE_WEBHOOK_SECRET_KEY=
# true = sandbox，false = live。同時決定 SDK 的 API host 與前端拿到的 environment。
PADDLE_SANDBOX=true
# 依 https://api.paddle.com/ips 擋掉非 Paddle 來源的 webhook（縱深防禦，驗簽仍是主要防線）。
# 預設關閉：服務跑在反向代理後面時 remote_addr 是代理的 IP，貿然開啟會擋掉所有 webhook。
# 開啟前先看一次 log 確認實際收到的 IP。
PADDLE_WEBHOOK_IP_ALLOWLIST=false
# 只有在確定前方代理會覆寫 X-Forwarded-For 時才開；這個標頭本身是外部可偽造的。
PADDLE_WEBHOOK_TRUSTED_PROXY=false

STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=

RAPID_API_KEY=
GROQ_API_KEY=
YOUTUBE_API_KEY=

VIDEOTRANSCRIBER_SECRET_KEY=
VIDEOTRANSCRIBER_EMAIL=
VIDEOTRANSCRIBER_PASSWORD=
# Comma-separated business codes that mean the session expired, e.g. 100002,100003
VIDEOTRANSCRIBER_UNAUTHORIZED_CODES=

# Swoole 的 worker 數量，留空則用 swoole_cpu_num()。
# 注意 swoole_cpu_num() 看得到的是**宿主機**的核心數，不是容器的 CPU 配額
# （見 docs/lore/framework/pitfalls.md），在容器裡通常要自己指定。
SERVER_WORKERS_NUMBER=
